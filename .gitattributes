# Normalise text files to LF in the repository.
* text=auto

# Shell scripts and git hooks must keep LF endings on every platform.
*.sh eol=lf
scripts/pre-commit eol=lf

# Windows batch files must keep CRLF endings.
*.bat eol=crlf

# Run folders and their inputs are checked by SHA-256 byte for byte: keep
# every file exactly as written, on every platform.
results/runs/** -text
results/controls/** -text
